{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@server/*": ["../server/src/*"]
    }
  },
  "include": ["src/**/*", "../server/src/router.ts"],
  "exclude": ["node_modules"]
}
